# Copiá este archivo a .env y completá los valores. Nunca subas .env.
FLY_API_TOKEN=
GITHUB_TOKEN=
APP_PASSWORD_HASH=
SESSION_SECRET=
# Servidor (todos opcionales en desarrollo)
PORT=
DATA_DIR=
NODE_ENV=
# Respaldo externo opcional (Backblaze B2, cifrado). Sin estos, queda desactivado.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
RESPALDO_CLAVE=
# Entrada por audio opcional (Groq). Sin esto, queda desactivada.
GROQ_API_KEY=
